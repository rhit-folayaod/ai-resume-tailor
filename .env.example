# Example environment for hosted / local-with-Supabase runs.
# Copy to `.env` and fill in. Never commit real secrets.

# OpenAI (or any OpenAI-compatible endpoint)
OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:11434/v1
RESUME_TAILOR_MODEL=gpt-4o-mini

# Leave SUPABASE_URL empty for local filesystem mode (projects.yaml).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Owner test login (hosted). Defaults to glorytothemoon if unset.
# Set ADMIN_PASSWORD=off to disable the password form on the sign-in page.
# ADMIN_PASSWORD=glorytothemoon

# Optional daily caps (hosted mode)
RESUME_TAILOR_DAILY_PARSE_LIMIT=30
RESUME_TAILOR_DAILY_COMPILE_LIMIT=20
